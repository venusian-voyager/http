{
    "name": "venusian-voyager/http",
    "description": "The Voyager HTTP client package.",
    "license": "MIT",
    "version": "0.9.0",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/uri-template": "^1.0",
        "venusian-voyager/collections": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/io-pools": "^0.9.0",
        "venusian-voyager/macroable": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0"
    },
    "suggest": {
        "ext-pcurl": "Loop-watched curl sockets for the pcurl async driver"
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Http\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
